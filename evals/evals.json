    {
      "id": "artifact-contract-core-fields",
      "type": "artifact",
      "path": "docs/output-contract.md",
      "must_contain": [
        "epistemic_status",
        "will_revise_if",
        "compliance_drift",
        "must_respond",
        "meta_engagement",
        "attention_manifests"

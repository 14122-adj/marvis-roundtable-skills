      "must_not_contain": ["TODO", "FIXME", "待补"]
    },
    {
      "id": "artifact-no-fabricated-models",
      "type": "artifact",
      "path": "skills/multi-model-adapter/references/provider-assignment-guide.md",
      "must_contain": ["unspecified"],
      "must_not_contain": ["gpt-", "claude-", "gemini-", "llama-", "qwen"]
    },
    {
      "id": "artifact-every-skill-has-description",
      "type": "artifact_glob",
